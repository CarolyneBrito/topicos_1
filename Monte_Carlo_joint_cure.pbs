#!/bin/bash
#PBS -N MonteCarloJointCure
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o Monte_Carlo_joint_cure.log

set -euo pipefail

# PBS_O_WORKDIR is the directory where qsub was invoked.
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"

# Prevent oversubscription from BLAS/OpenMP libraries.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# If your cluster uses environment modules, uncomment and adapt:
# module load R

command -v Rscript >/dev/null 2>&1 || { echo 'ERROR: Rscript is not available. Load the R module first.' >&2; exit 1; }
test -f Monte_Carlo_joint_cure.R || { echo 'ERROR: Monte_Carlo_joint_cure.R not found.' >&2; exit 1; }

echo "Job ID: ${PBS_JOBID:-unknown}"
echo "Host: $(hostname)"
echo "Started: $(date)"
echo "Directory: $(pwd)"
Rscript --vanilla Monte_Carlo_joint_cure.R
echo "Finished: $(date)"
